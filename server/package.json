{
  "name": "@pfd/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:demo": "tsx src/seed-demo.ts",
    "demo": "tsx src/seed-demo.ts --demo --if-empty && node dist/index.js --demo"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.14.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "mercadopago": "3.6.1",
    "papaparse": "^5.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.5"
  }
}
