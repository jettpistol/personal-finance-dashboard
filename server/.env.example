# Copy to server/.env and fill in. Never commit the real file.

PORT=3001
NODE_ENV=development

# <REPLACE> Access token from Your integrations > (your app) > Credentials.
#   TEST-...    test credentials: only see test-user data, never your real account
#   APP_USR-... production credentials: required to read your real balance, payments and reports
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# <REPLACE> "Secret signature" from Your integrations > (your app) > Webhooks > Configure notifications.
# Test and production modes each show their own secret.
MP_WEBHOOK_SECRET=replace-me

# Replay window for the x-signature timestamp, in seconds. 0 disables the check.
MP_WEBHOOK_TOLERANCE_SECONDS=300

# <REPLACE> Long random string; the dashboard frontend sends it as "Authorization: Bearer <token>".
#   generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_API_TOKEN=replace-me

DATABASE_PATH=./data/finance.db

# Background reconcile via /v1/payments/search, in minutes (safety net for missed webhooks). 0 disables.
MP_RECONCILE_INTERVAL_MINUTES=15
