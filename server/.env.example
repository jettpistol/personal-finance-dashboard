# Copy this file to `.env` in this same folder (server/) and fill it in. `.env` is git-ignored.
# Restart the app after changing it.

# Email notifications (free with Gmail):
# 1. Turn on 2-Step Verification in your Google account.
# 2. Create an app password at https://myaccount.google.com/apppasswords (16 letters).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-letter-app-password
# Optional: how the sender is shown.
MAIL_FROM=Finanzas <your-address@gmail.com>

# Optional: the address the app is reachable at, so emails can link to the right page.
# PUBLIC_URL=https://finanzas.example.com
