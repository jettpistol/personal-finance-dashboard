# Copy to .env and adjust.

# Telegram bot for alerts and the monthly review (create one with @BotFather). Optional.
TELEGRAM_BOT_TOKEN=

# Public URL, used for links in Telegram messages. Example: https://finanzas.example.com
PUBLIC_URL=

# Set to true when served over HTTPS (Caddy profile), so session cookies are Secure.
SECURE_COOKIES=false

# Domain for Caddy (only with: docker compose --profile https up -d)
DOMAIN=

# Where the app port is bound on the host. Keep 127.0.0.1 when using Caddy or Tailscale serve.
APP_BIND=127.0.0.1

# Backups kept in data/backups
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_MONTHLY=12

# Mercado Pago (see docs/mercadopago.md). Key that encrypts the access tokens: 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Empty = generated once in data/mp-token.key (then keep that file out of off-site backups).
MP_TOKEN_KEY=

# Public HTTPS base Mercado Pago can reach for webhooks, e.g. https://vm.tailnet.ts.net:8443
# (Tailscale Funnel on the webhook path only). Defaults to PUBLIC_URL.
MP_WEBHOOK_BASE_URL=
